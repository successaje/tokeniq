# Copy to .env for local development. All values here are placeholders.
NODE_ENV=development
DATABASE_URL=postgres://localhost:5432/tokeniq_dev
# Public origin of the web app; the API is reached through its /api proxy.
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
RUN_JOBS=true
LOG_LEVEL=info
# Optional: email delivery (without it, development prints codes to the API log)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="TokenIQ <no-reply@example.com>"
# Optional: copilot
# ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-opus-5-5
# Optional: dedicated RPC endpoints (recommended in production)
# RPC_URL_1=
# RPC_URL_8453=
# RPC_URL_42161=
# RPC_URL_10=
# Comma-separated kill switches: copilot,proposals,signatures,sync,opportunities,email
# DISABLED_FEATURES=
# Web (build-time)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_SITE_URL=https://tokeniq.example
# API_INTERNAL_URL=http://localhost:4000
