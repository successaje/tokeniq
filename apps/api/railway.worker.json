{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": ["apps/api/**", "packages/core/**", "packages/chain/**", "packages/db/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "node --import tsx src/worker.ts",
    "restartPolicyType": "ALWAYS"
  }
}
